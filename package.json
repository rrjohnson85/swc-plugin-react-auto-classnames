{
    "name": "swc-plugin-react-auto-classnames",
    "version": "0.1.8",
    "description": "SWC plugin to automatically add classnames to react components (filename and component name)",
    "author": "Eric Halvorsen <Viscousness@Gmail.com>",
    "license": "MIT",
    "keywords": ["swc-plugin"],
    "main": "swc_plugin_react_auto_classnames.wasm",
    "files": [
        "target/wasm32-wasip1/release/swc_plugin_react_auto_classnames.wasm"
    ],
    "preferUnplugged": true,
    "repository": "https://github.com/hjkcai/swc-plugin-add-display-name",
    "scripts": {
        "prepack": "cargo build-wasi --release && cp target/wasm32-wasip1/release/swc_plugin_react_auto_classnames.wasm ."
    },
    "peerDependencies": {
        "@swc/core": "~1.10.0"
    },
    "devDependencies": {
        "@swc/cli": "^0.6.0",
        "@swc/core": "~1.10.0"
    }
}
